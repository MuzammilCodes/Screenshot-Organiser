<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- File access permissions -->
	<uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
	<!-- System overlay permissions -->
	<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
	<!-- Service permissions -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<!-- Query all packages for content observation -->
	<queries>
		<intent>
			<action android:name="android.intent.action.MAIN" />
		</intent>
	</queries>
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:supportsRtl="true" android:label="Screenshot Organiser">
		<!-- REMOVED: android:requestLegacyExternalStorage="true" -->
		<!-- This was causing permission issues on Android 11+ -->
		<!-- File provider for sharing files -->
		<provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true">
			<meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
		</provider>
		<!-- Overlay Service with proper foreground service type -->
		<service android:name="Screenshot_Organiser.Platforms.Android.OverlayService" android:enabled="true" android:exported="false" android:foregroundServiceType="dataSync" />
	</application>
</manifest>