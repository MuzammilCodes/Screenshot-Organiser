<Project Sdk="Microsoft.NET.Sdk">

  <!-- Always applies -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Screenshot_Organiser</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <TargetPlatformVersion>34</TargetPlatformVersion>
  </PropertyGroup>

  <!-- Release-only settings -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidSupportedAbis>arm64-v8a</AndroidSupportedAbis>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <!-- Keep portable symbols for readable crash stacks in Play Console -->
    <DebugType>portable</DebugType>

    <!-- Release signing (secrets come from environment variables, never commit them)
         Set before building:
           ANDROID_KEYSTORE_PATH      - full path to your .keystore/.jks file
           ANDROID_KEYSTORE_ALIAS     - key alias
           ANDROID_KEYSTORE_PASSWORD  - keystore password
           ANDROID_KEY_PASSWORD       - key password -->
    <AndroidKeyStore Condition="'$(ANDROID_KEYSTORE_PATH)' != ''">true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(ANDROID_KEYSTORE_PATH)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(ANDROID_KEYSTORE_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>$(ANDROID_KEYSTORE_PASSWORD)</AndroidSigningStorePass>
    <AndroidSigningKeyPass>$(ANDROID_KEY_PASSWORD)</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- Debug-only settings -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->

    <MauiSplashScreen Include="Resources\Splash\splash.svg"
                      Color="#FFFFFF"
                      BaseSize="192,192"
                      Resize="true" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Platforms\Android\Resources\drawable\btn_primary.xml" />
    <None Remove="Platforms\Android\Resources\drawable\btn_secondary.xml" />
    <None Remove="Platforms\Android\Resources\drawable\dialog_background.xml" />
    <None Remove="Platforms\Android\Resources\drawable\ic_screenshot.xml" />
    <None Remove="Platforms\Android\Resources\layout\overlay_screenshot_dialog.xml" />
    <None Remove="Platforms\Android\Resources\xml\file_paths.xml" />
    <None Remove="Resources\AppIcon\appicon.svg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core MAUI packages -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.91" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />

    <!-- Community Toolkit -->
    <PackageReference Include="CommunityToolkit.Maui" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </MauiIcon>
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
  </ItemGroup>

</Project>
